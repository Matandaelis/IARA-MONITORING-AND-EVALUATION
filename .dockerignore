# Git
.git
.gitignore
.gitattributes

# IDEs
.vs
.vscode
.idea
*.swp
*.swo
*.user
*.suo
*.userosscache
*.sln.docstates

# Docker files themselves (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
progress.md

# Build outputs (any depth: WEB/bin, WEB/obj, ...)
**/bin/
**/obj/
**/dist/
**/.angular/

# Node dependencies (source + lockfile + patches ARE included)
**/node_modules/
npm-debug.log
yarn.lock

# Dependencies
packages/

# Environment files (secrets must never enter the image)
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
*.tmp

# Logs and symbols
*.log
*.pdb
*.cache

# Tests and coverage (backend tests are not part of the runtime image)
WEB.Tests/
coverage/
test-results/

# Docs
docs/
*.md

# CI/CD
.github/

# Misc
.prettierignore
.editorconfig
*.sublime-project
*.sublime-workspace
