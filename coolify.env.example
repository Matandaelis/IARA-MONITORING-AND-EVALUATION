# Coolify production deployment template
# Copy this to your Coolify environment variables or save as .env before local testing.
# Replace all placeholders before deploy.

DB_PASSWORD=ChangeMeStrongPassword123!
DB_HOST=monic-db
DB_PORT=1433
DB_NAME=MONIC
DB_USER=sa
APP_PORT=80
ROOT_URL=https://your-domain.example.com/
SITE_NAME=MONIC
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

ConnectionStrings__DefaultConnection=Server=monic-db,1433;Database=MONIC;User Id=sa;Password=ChangeMeStrongPassword123!;TrustServerCertificate=true;Encrypt=false;

Settings__RootUrl=https://your-domain.example.com/
Settings__SiteName=MONIC
Settings__UseAzureInfrastructure=false
Settings__AccessTokenExpiryMinutes=10
Settings__RefreshTokenExpiryMinutes=10880
Settings__EmailSettings__SendEmails=false
Settings__EmailSettings__SenderName=MONIC
Settings__EmailSettings__Sender=noreply@your-domain.example.com
Settings__EmailSettings__SMTP=smtp.example.com
Settings__EmailSettings__SMTPPort=587
Settings__EmailSettings__UserName=
Settings__EmailSettings__Password=
Settings__EmailSettings__SSL=true
Settings__EmailSettings__EmailToErrors=admin@your-domain.example.com
Settings__EmailSettings__SubstitutionEmailAddress=admin@your-domain.example.com
Settings__UseApplicationInsights=false
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
