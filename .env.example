# =======================================================
# MONIC ENVIRONMENT CONFIGURATION (.env)
# =======================================================

# -------------------------------------------------------
# Database Configuration (SQL Server)
# -------------------------------------------------------
# Strong SA Password: min 8 characters with upper, lower, digit, and symbol
DB_PASSWORD=@Monic123Secure!
DB_HOST=monic-db
DB_PORT=1433
DB_NAME=MONIC
DB_USER=sa

# -------------------------------------------------------
# Application & Web Configuration
# -------------------------------------------------------
SITE_NAME=MONIC

# Port on the host machine to access the application
# Use 8080 for local development (avoids conflicts with IIS/port 80)
# Use 80 or 443 for standalone Linux servers or VPS
APP_PORT=8080

# The public URL of the application (must end with a slash /)
# For local Docker: http://localhost:8080/
# For Coolify / Production: https://monic.yourdomain.com/
ROOT_URL=http://localhost:8080/

# Environment: "Production" or "Development"
ASPNETCORE_ENVIRONMENT=Production

# -------------------------------------------------------
# Token Lifetime Configuration (Optional)
# -------------------------------------------------------
ACCESS_TOKEN_EXPIRY=10
REFRESH_TOKEN_EXPIRY=10880

# -------------------------------------------------------
# Certificate (Optional - for persistent OpenIddict token signing)
# -------------------------------------------------------
CERTIFICATE_PASSWORD=

# -------------------------------------------------------
# Email Settings (Optional)
# -------------------------------------------------------
SEND_EMAILS=false
EMAIL_SENDER_NAME=MONIC
EMAIL_SENDER=noreply@monic.local
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
ERROR_EMAIL=admin@monic.local
SUBSTITUTION_EMAIL=admin@monic.local

# -------------------------------------------------------
# Cloud / Azure Features (Optional - leave false for Docker/Coolify/Render/AWS)
# -------------------------------------------------------
USE_AZURE_INFRASTRUCTURE=false
USE_APP_INSIGHTS=false
KEYVAULT_URI=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# -------------------------------------------------------
# Logging Level
# -------------------------------------------------------
LOG_LEVEL=Information
